generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  name         String
  role         String   @default("EMPLOYEE") // EMPLOYEE, MANAGER, ADMIN
  department   String?
  managerId    String?
  azureAdId    String?  @unique
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  manager      User?    @relation("ManagerReports", fields: [managerId], references: [id])
  reports      User[]   @relation("ManagerReports")

  goalSheets          GoalSheet[]          @relation("EmployeeGoalSheets")
  approvedGoalSheets  GoalSheet[]          @relation("ApprovedBy")
  checkIns            CheckIn[]
  auditLogs           AuditLog[]
  escalationsTarget   Escalation[]         @relation("EscalationTarget")
  notifications       Notification[]
  achievementUpdates  QuarterlyAchievement[] @relation("AchievementUpdater")
}

model GoalCycle {
  id                String   @id @default(uuid())
  name              String
  goalSettingOpens  DateTime
  goalSettingCloses DateTime
  q1Opens           DateTime
  q1Closes          DateTime
  q2Opens           DateTime
  q2Closes          DateTime
  q3Opens           DateTime
  q3Closes          DateTime
  q4Opens           DateTime
  q4Closes          DateTime
  status            String   @default("ACTIVE") // ACTIVE, CLOSED
  createdAt         DateTime @default(now())

  goalSheets  GoalSheet[]
  escalations Escalation[]
}

model GoalSheet {
  id            String    @id @default(uuid())
  employeeId    String
  cycleId       String
  status        String    @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, RETURNED
  submittedAt   DateTime?
  approvedAt    DateTime?
  approvedById  String?
  returnComment String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employee   User      @relation("EmployeeGoalSheets", fields: [employeeId], references: [id])
  cycle      GoalCycle @relation(fields: [cycleId], references: [id])
  approvedBy User?     @relation("ApprovedBy", fields: [approvedById], references: [id])
  goals      Goal[]
  checkIns   CheckIn[]

  @@unique([employeeId, cycleId])
}

model Goal {
  id              String  @id @default(uuid())
  goalSheetId     String
  sortOrder       Int     @default(0)
  thrustArea      String
  title           String
  description     String?
  uomType         String  // MIN_NUMERIC, MIN_PERCENT, MAX_NUMERIC, MAX_PERCENT, TIMELINE, ZERO
  target          String
  weightage       Int
  isShared        Boolean @default(false)
  sharedFromGoalId String?
  titleReadOnly   Boolean @default(false)
  targetReadOnly  Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  goalSheet      GoalSheet             @relation(fields: [goalSheetId], references: [id], onDelete: Cascade)
  sharedFrom     Goal?                 @relation("SharedGoals", fields: [sharedFromGoalId], references: [id])
  sharedTo       Goal[]                @relation("SharedGoals")
  achievements   QuarterlyAchievement[]
}

model QuarterlyAchievement {
  id            String   @id @default(uuid())
  goalId        String
  quarter       String   // Q1, Q2, Q3, Q4
  actualValue   String?
  status        String   @default("NOT_STARTED") // NOT_STARTED, ON_TRACK, COMPLETED
  computedScore Float?
  updatedAt     DateTime @updatedAt
  updatedById   String?

  goal      Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  updatedBy User? @relation("AchievementUpdater", fields: [updatedById], references: [id])

  @@unique([goalId, quarter])
}

model CheckIn {
  id            String   @id @default(uuid())
  goalSheetId   String
  quarter       String
  employeeNotes String?
  managerComment String?
  checkedInAt   DateTime @default(now())
  managerId     String

  goalSheet GoalSheet @relation(fields: [goalSheetId], references: [id])
  manager   User      @relation(fields: [managerId], references: [id])

  @@unique([goalSheetId, quarter])
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String
  action        String
  entityType    String
  entityId      String
  previousValue String?
  newValue      String?
  timestamp     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model EscalationRule {
  id               String  @id @default(uuid())
  type             String  // GOAL_NOT_SUBMITTED, GOAL_NOT_APPROVED, CHECKIN_OVERDUE
  daysThreshold    Int
  escalationLevels String  // JSON array
  isActive         Boolean @default(true)
  createdAt        DateTime @default(now())

  escalations Escalation[]
}

model Escalation {
  id           String    @id @default(uuid())
  ruleId       String
  targetUserId String
  cycleId      String
  currentLevel Int       @default(0)
  status       String    @default("OPEN") // OPEN, ACKNOWLEDGED, RESOLVED
  triggeredAt  DateTime  @default(now())
  resolvedAt   DateTime?

  rule   EscalationRule @relation(fields: [ruleId], references: [id])
  target User           @relation("EscalationTarget", fields: [targetUserId], references: [id])
  cycle  GoalCycle      @relation(fields: [cycleId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model AppSettings {
  id    String @id @default("app")
  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  smtpPass     String?
  smtpFrom     String?
  teamsWebhookUrl String?
  azureTenantId   String?
  azureClientId   String?
  azureClientSecret String?
}
